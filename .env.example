# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_KEY=xxxxx

# Anthropic API (optional - AI features disabled without this)
ANTHROPIC_API_KEY=xxxxx

# Admin (generate with: node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(h=>console.log(h))")
ADMIN_PASSWORD_HASH=

# App
PORT=5000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-secret-string

# Frontend (used by Vite)
VITE_API_URL=http://localhost:5000/api
